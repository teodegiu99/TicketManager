<UserControl
    x:Class="ClientIT.Controls.DocumentationDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Click="Back_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Indietro">
                <FontIcon Glyph="&#xE72B;"/>
            </Button>
            <TextBlock Text="Dettaglio Documentazione" Style="{ThemeResource TitleTextBlockStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtTitolo" Header="Titolo" PlaceholderText="Titolo della guida"/>
            <ComboBox x:Name="CmbCategoria" Grid.Column="1" Header="Categoria" HorizontalAlignment="Stretch" 
                      DisplayMemberPath="Nome" SelectedValuePath="Id" PlaceholderText="Seleziona categoria"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtQuery" Header="Query SQL (Opzionale)" PlaceholderText="SELECT * FROM..." 
                     AcceptsReturn="True" Height="100" FontFamily="Consolas"/>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Keywords" Style="{ThemeResource CaptionTextBlockStyle}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNewKeyword" PlaceholderText="Nuova keyword (Invio per aggiungere)..." KeyDown="TxtNewKeyword_KeyDown"/>
                    <Button Grid.Column="1" Content="+" Click="BtnAddKeyword_Click"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="60">
                    <ItemsControl x:Name="IcKeywords">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="32"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="16" Margin="0,0,4,4" Padding="8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                                Background="Transparent" BorderThickness="0" 
                                                Width="20" Height="20" Padding="0"
                                                Click="BtnRemoveKeyword_Click" Tag="{Binding}" ToolTipService.ToolTip="Rimuovi"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="True">
                <AppBarButton Icon="Bold" Label="Grassetto" Click="Editor_Bold_Click"/>
                <AppBarButton Icon="Italic" Label="Corsivo" Click="Editor_Italic_Click"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Pictures" Label="Inserisci Immagine" Click="Editor_AddImage_Click"/>
            </CommandBar>

            <RichEditBox x:Name="RtbSoluzione" Grid.Row="1" 
                         BorderThickness="0" Background="Transparent" 
                         Padding="12" PlaceholderText="Scrivi qui la soluzione..."
                         AcceptsReturn="True"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="Annulla" Click="Back_Click"/>
            <Button Content="Salva Modifiche" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
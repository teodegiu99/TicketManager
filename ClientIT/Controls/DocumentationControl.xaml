<UserControl
    x:Class="ClientIT.Controls.DocumentationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClientIT.Models" 
    xmlns:local="using:ClientIT.Controls"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1200">

    <Grid>
        <Grid x:Name="ListViewArea" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,24,0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <AutoSuggestBox x:Name="MainSearchBox" 
                                QueryIcon="Find" 
                                PlaceholderText="Cerca per Titolo o Soluzione..." 
                                HorizontalAlignment="Stretch"
                                QuerySubmitted="MainSearchBox_QuerySubmitted"/>

                <ListView x:Name="DocsListView" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="DocsListView_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DocumentazioneDto">
                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Fill="{Binding CategoriaColore}" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Titolo}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding CategoriaNome}" FontSize="12" Opacity="0.6"/>
                                    <TextBlock Text="Clicca per leggere la soluzione completa..." FontSize="11" Opacity="0.5" FontStyle="Italic" Margin="0,4,0,0"/>

                                    <ItemsControl ItemsSource="{Binding KeywordNomi}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <Run Text="Ticket #"/>
                                            <Run Text="{Binding Nticket}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Background="{ThemeResource LayerFillColorAltBrush}" Padding="16" CornerRadius="8">
                    <Button x:Name="BtnNewDoc" 
                HorizontalAlignment="Stretch" 
                Style="{ThemeResource AccentButtonStyle}" 
                Click="BtnNewDoc_Click"
                Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="Nuova Documentazione"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <FontIcon Glyph="&#xE71C;"/>
                        <TextBlock Text="Filtri Avanzati" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </StackPanel>

                    <ComboBox x:Name="FilterTipologia" Header="Tipologia" HorizontalAlignment="Stretch" 
                              DisplayMemberPath="Nome" SelectedValuePath="Id" PlaceholderText="Tutte"/>

                    <TextBox x:Name="FilterNticket" Header="Numero Ticket" PlaceholderText="Es: 1024" InputScope="Number"/>

                    <TextBox x:Name="FilterQuery" Header="Query SQL" PlaceholderText="Filtra per parametro o per tabella"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Keywords" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFilterKeyword" PlaceholderText="Aggiungi..." KeyDown="TxtFilterKeyword_KeyDown"/>
                            <Button Grid.Column="1" Content="+" Click="BtnAddFilterKeyword_Click"/>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind FilterKeywords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemHeight="32"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="16" Margin="0,0,8,8" Padding="12,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                                    Background="Transparent" BorderThickness="0" Foreground="White"
                                                    Padding="0" MinWidth="20" Height="20" VerticalAlignment="Center"
                                                    Click="BtnRemoveFilterKeyword_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnSpacing="12" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Resetta" HorizontalAlignment="Stretch" Click="BtnReset_Click"/>
                        <Button Content="Cerca" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Grid.Column="1" Click="BtnSearch_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailViewArea" Visibility="Collapsed">
            <local:DocumentationDetailControl x:Name="DocDetailControl"/>
        </Grid>
    </Grid>
</UserControl>
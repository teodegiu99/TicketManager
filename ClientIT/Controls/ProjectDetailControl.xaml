<UserControl
    x:Class="ClientIT.Controls.ProjectDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientIT.Controls"
    xmlns:models="using:ClientIT.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes" 
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16" Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Margin="0,0,16,0">
                <FontIcon Glyph="&#xE72B;"/>
            </Button>

            <TextBlock Grid.Column="1" Text="{x:Bind Project.Titolo, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="CmbStato" Header="Stato" Width="150" 
                          ItemsSource="{x:Bind StatusOptions, Mode=OneWay}" 
                          SelectedValue="{x:Bind Project.StatoId, Mode=TwoWay}"
                          DisplayMemberPath="Nome" 
                          SelectedValuePath="Id"/>

                <ComboBox x:Name="CmbAssegnatoA" Header="Assegnato a" Width="180" 
                          ItemsSource="{x:Bind UsersOptions, Mode=OneWay}" 
                          SelectedValue="{x:Bind Project.AssegnatoAId, Mode=TwoWay}"
                          DisplayMemberPath="Nome" 
                          SelectedValuePath="Id"/>

                <Button Content="Salva Modifiche" Click="BtnSaveProject_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="32">

                <TextBox x:Name="TxtTitolo" Header="Titolo (Modificabile)" Text="{x:Bind Project.Titolo, Mode=TwoWay}" />
                <TextBox x:Name="TxtDescrizione" Header="Descrizione" Text="{x:Bind Project.Descrizione, Mode=TwoWay}" 
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fasi e Roadmap" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Button Grid.Column="1" Click="BtnAddPhase_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="Nuova Fase"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView x:Name="PhasesListView" ItemsSource="{x:Bind Phases}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PhasesListView_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PhaseViewModel">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Titolo}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Descrizione}" FontSize="12" Opacity="0.6" MaxLines="1"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnRemovePhase_Click" Tag="{x:Bind}" Background="Transparent">
                                    <FontIcon Glyph="&#xE74D;" Foreground="Red"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" Visibility="{x:Bind HasPhases, Mode=OneWay}">
                    <Grid Width="{x:Bind RoadmapWidth, Mode=OneWay}" MinHeight="100" Margin="0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ItemsControl ItemsSource="{x:Bind TimelineLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TimelineLabel">
                                    <TextBlock Text="{x:Bind Text}" Margin="{x:Bind Margin}" FontSize="10" Opacity="0.5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind RoadmapItems}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RoadmapItem">
                                    <Grid Height="30">
                                        <Button Margin="{x:Bind Margin}" Width="{x:Bind Width}" Background="{x:Bind Color}" 
                                                Padding="0" CornerRadius="4" HorizontalAlignment="Left"
                                                Height="24" 
                                                ToolTipService.ToolTip="{x:Bind TooltipText}" Tag="{x:Bind}" Click="RoadmapItem_Click"/>

                                        <TextBlock Text="{x:Bind DateText}" Margin="{x:Bind TextMargin}" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        BorderThickness="1" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Height="350">
                    <ListView x:Name="CommentsListView" ItemsSource="{x:Bind Comments}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommentoViewModel">
                                <Grid Margin="0,4" HorizontalAlignment="{x:Bind Allineamento}">
                                    <Grid.ColumnDefinitions>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{x:Bind Sfondo}" 
                            CornerRadius="12" 
                            Padding="12,8"
                            MaxWidth="400">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Opacity="0.7">
                                                    <Grid Width="20" Height="20" CornerRadius="10" Background="Black" Margin="0,0,6,0">
                                                        <TextBlock Text="{x:Bind Iniziali}" 
                                                Foreground="White" 
                                                FontSize="10" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center" 
                                                FontWeight="Bold"/>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind Username}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{x:Bind ColoreTesto}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{x:Bind DataCreazione}" FontSize="10" 
                                           Foreground="{x:Bind ColoreTesto}"/>
                                                </StackPanel>

                                                <TextBlock Text="{x:Bind Testo}" 
                                       TextWrapping="Wrap" 
                                       Foreground="{x:Bind ColoreTesto}" 
                                       FontSize="14"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCommento" PlaceholderText="Scrivi un commento..." KeyDown="TxtCommento_KeyDown"/>
                    <Button Grid.Column="1" Click="BtnSendComment_Click" Style="{ThemeResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;"/>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>